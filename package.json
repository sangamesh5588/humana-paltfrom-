{
  "name": "human-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --concurrency=16",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "prisma:generate": "prisma generate --schema=database/prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=database/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=database/prisma/schema.prisma",
    "db:seed": "ts-node -p services/api/tsconfig.json database/prisma/seed.ts"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "turbo": "^2.0.4",
    "typescript": "^5.1.3",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.1",
    "use-latest-callback": "^0.3.4"
  },
  "packageManager": "pnpm@10.33.2"
}
